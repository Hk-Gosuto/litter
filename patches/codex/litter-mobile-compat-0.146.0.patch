+fn split_realtime_tool_name(name: &str) -> (Option<String>, String) {
+    match name.split_once("__") {
+        Some((namespace, tool)) if !namespace.is_empty() && !tool.is_empty() => {
+            (Some(namespace.to_string()), tool.to_string())
+        }
+        _ => (None, name.to_string()),
+    }
+}
+
+fn realtime_tool_call_arguments(item: &serde_json::Value) -> serde_json::Value {
+    match item.get("arguments") {
+        Some(serde_json::Value::String(raw)) => {
+            serde_json::from_str(raw).unwrap_or_else(|_| serde_json::json!({}))
+        }
+        Some(value) if value.is_object() => value.clone(),
+        Some(value) => value.clone(),
+        None => serde_json::json!({}),
+    }
+}
+
+fn realtime_dynamic_tool_output(value: serde_json::Value) -> String {
+    let Ok(response) = serde_json::from_value::<DynamicToolCallResponse>(value) else {
+        return "Tool call failed".to_string();
+    };
+    let texts: Vec<&str> = response
+        .content_items
+        .iter()
+        .filter_map(|item| match item {
+            DynamicToolCallOutputContentItem::InputText { text } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect();
+    if !texts.is_empty() {
+        return texts.join("");
+    }
+    if !response.success {
+        return "Tool call failed".to_string();
+    }
+    serde_json::to_string(&response).unwrap_or_default()
+}
