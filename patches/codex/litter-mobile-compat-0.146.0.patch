+        use crate::exec::IOS_EXEC_HOOK;
+        use crate::exec::IOS_STREAMING_EXEC_HOOK;
+        use crate::exec::IosExecOutputHandler;
+        use crate::exec::MOBILE_EXEC_PREFLIGHT;
+
+        let event_ctx = ToolEventCtx::new(
+            context.session.as_ref(),
+            context.turn.as_ref(),
+            &context.call_id,
+            None,
+        );
+        let emitter = ToolEmitter::unified_exec(
+            &request.command,
+            cwd.clone(),
+            ExecCommandSource::UnifiedExecStartup,
+            Some(request.process_id.to_string()),
+            None,
+        );
+        emitter.emit(event_ctx, ToolEventStage::Begin).await;
+
+        let env = create_env(
+            &context.turn.config.permissions.shell_environment_policy,
+            Some(context.session.thread_id),
+        );
+        let start = Instant::now();
+        let transcript = Arc::new(tokio::sync::Mutex::new(HeadTailBuffer::default()));
+        let (chunk_tx, mut chunk_rx) = tokio::sync::mpsc::unbounded_channel::<Vec<u8>>();
+        let output_handler: IosExecOutputHandler = Arc::new(move |chunk| {
+            let _ = chunk_tx.send(chunk);
+        });
+        // iSH oneshot cannot yield a live process_id. Do not treat
+        // yield_time_ms as a kill deadline; keep a long safety cap so
+        // builds/tests can finish, then map hook timeout to a tool error.
+        let timeout_ms = Some(super::DEFAULT_MAX_BACKGROUND_TERMINAL_TIMEOUT_MS);
+        let cancel = crate::exec::IosExecCancel::new();
+        let mut cancel_guard = cancel.drop_guard();
+        let mut join = tokio::task::spawn_blocking({
+            let mut command = request.command.clone();
+            let cwd = cwd.to_path_buf();
+            let output_handler = Arc::clone(&output_handler);
+            let cancel = cancel.clone();
+            move || {
+                if let Some(preflight) = MOBILE_EXEC_PREFLIGHT.get() {
+                    preflight(&mut command);
+                }
+                if let Some(streaming_hook) = IOS_STREAMING_EXEC_HOOK.get() {
+                    streaming_hook(&command, &cwd, &env, timeout_ms, output_handler, &cancel)
+                } else {
+                    IOS_EXEC_HOOK
+                        .get()
+                        .map(|hook| hook(&command, &cwd, &env, timeout_ms, &cancel))
+                        .unwrap_or((-1, b"no iOS exec hook registered\n".to_vec()))
+                }
+            }
+        });
