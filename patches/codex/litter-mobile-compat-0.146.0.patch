+pub(super) fn dynamic_tools_to_session_tools(
+    dynamic_tools: Option<Vec<DynamicToolSpec>>,
+) -> Vec<SessionFunctionTool> {
+    dynamic_tools
+        .unwrap_or_default()
+        .into_iter()
+        .flat_map(|tool| match tool {
+            DynamicToolSpec::Function(function) => vec![(None, function)],
+            DynamicToolSpec::Namespace(namespace) => namespace
+                .tools
+                .into_iter()
+                .map(|DynamicToolNamespaceTool::Function(function)| {
+                    (Some(namespace.name.clone()), function)
+                })
+                .collect(),
+        })
+        .filter(|(_, tool)| !tool.defer_loading)
+        .map(
+            |(
+                namespace,
+                DynamicToolFunctionSpec {
+                    name,
+                    description,
+                    input_schema,
+                    ..
+                },
+            )| SessionFunctionTool {
+                r#type: SessionToolType::Function,
+                name: realtime_session_tool_name(namespace.as_deref(), name),
+                description,
+                parameters: input_schema,
+            },
+        )
+        .collect()
+}
+
+pub(super) fn realtime_session_tool_name(namespace: Option<&str>, name: String) -> String {
