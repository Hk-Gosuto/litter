+fn dynamic_tool_spec_matches(
+    specs: &[codex_protocol::dynamic_tools::DynamicToolSpec],
+    name: &str,
+    namespace: Option<&str>,
+) -> bool {
+    use codex_protocol::dynamic_tools::DynamicToolNamespaceTool;
+    use codex_protocol::dynamic_tools::DynamicToolSpec;
+
+    specs.iter().any(|spec| match spec {
+        DynamicToolSpec::Function(function) => namespace.is_none() && function.name == name,
+        DynamicToolSpec::Namespace(spec_namespace) => spec_namespace.tools.iter().any(|tool| {
+            let DynamicToolNamespaceTool::Function(function) = tool;
+            function.name == name
+                && (namespace == Some(spec_namespace.name.as_str()) || namespace.is_none())
+        }),
+    })
+}
