+#[tokio::test]
+async fn ios_exec_cancel_wakes_only_matching_waiter() {
+    let first = IosExecCancel::new();
+    let second = IosExecCancel::new();
+    let first_for_task = first.clone();
+    let (tx, mut rx) = tokio::sync::oneshot::channel();
+    tokio::spawn(async move {
+        first_for_task.cancelled().await;
+        let _ = tx.send(());
+    });
+
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    second.cancel();
+    assert!(
+        timeout(Duration::from_millis(30), &mut rx).await.is_err(),
+        "cancelling one exec must not wake another exec's waiter"
+    );
+
+    first.cancel();
+    timeout(Duration::from_millis(100), rx)
+        .await
+        .expect("cancel should wake the matching waiter")
+        .expect("waiter should finish");
+}
