+/// iSH hook timeout sentinel. Matches Litter `ISH_E_TIMEOUT`.
+#[cfg(target_os = "ios")]
+pub(crate) const IOS_EXEC_HOOK_TIMEOUT_CODE: i32 = -8;
+
+#[cfg(target_os = "ios")]
+const IOS_EXEC_INTERRUPT_JOIN_GRACE: Duration = Duration::from_millis(750);
+
+#[cfg(target_os = "ios")]
+async fn exec_ios_hook(
+    command: Vec<String>,
+    cwd: AbsolutePathBuf,
+    env: HashMap<String, String>,
+    expiration: ExecExpiration,
+    capture_policy: ExecCapturePolicy,
+) -> Result<RawExecToolCallOutput> {
+    let timeout_ms = capture_policy
+        .uses_expiration()
+        .then(|| expiration.timeout_ms())
+        .flatten();
+    let cancel = IosExecCancel::new();
+    let mut cancel_guard = cancel.drop_guard();
+    let cancel_for_hook = cancel.clone();
+    let mut join = tokio::task::spawn_blocking(move || {
+        IOS_EXEC_HOOK
+            .get()
+            .map(|hook| hook(&command, cwd.as_path(), &env, timeout_ms, &cancel_for_hook))
+            .unwrap_or_else(|| {
+                (
+                    -1,
+                    b"shell exec unavailable: no iOS exec hook registered\n".to_vec(),
+                )
+            })
+    });
+
+    let (code, data, timed_out) = if capture_policy.uses_expiration() {
+        tokio::select! {
+            result = &mut join => {
+                cancel_guard.disarm();
+                let (code, data) = result.unwrap_or_else(|_| {
+                    (-1, b"spawn_blocking panicked\n".to_vec())
+                });
+                (code, data, ios_exec_hook_timed_out(code))
+            }
+            outcome = expiration.wait_with_outcome() => {
+                cancel.cancel();
+                match tokio::time::timeout(IOS_EXEC_INTERRUPT_JOIN_GRACE, &mut join).await {
+                    Ok(result) => {
+                        cancel_guard.disarm();
+                        let (code, data) = result.unwrap_or_else(|_| {
+                            (-1, b"spawn_blocking panicked\n".to_vec())
+                        });
+                        match outcome {
+                            ExecExpirationOutcome::TimedOut => (
+                                if ios_exec_hook_timed_out(code) {
+                                    code
+                                } else {
+                                    EXEC_TIMEOUT_EXIT_CODE
+                                },
+                                data,
+                                true,
+                            ),
+                            ExecExpirationOutcome::Cancelled => (code, data, false),
+                        }
+                    }
+                    Err(_) => {
+                        // abort() cannot stop a spawn_blocking closure that is
+                        // already running. Leave the guard armed so drop
+                        // cancels again if the hook registered late.
+                        cancel.cancel();
+                        join.abort();
+                        match outcome {
+                            ExecExpirationOutcome::TimedOut => (
+                                EXEC_TIMEOUT_EXIT_CODE,
+                                b"command timed out\n".to_vec(),
+                                true,
+                            ),
+                            ExecExpirationOutcome::Cancelled => {
+                                (1, b"command cancelled\n".to_vec(), false)
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    } else {
+        let (code, data) = join
+            .await
+            .unwrap_or_else(|_| (-1, b"spawn_blocking panicked\n".to_vec()));
+        cancel_guard.disarm();
+        (code, data, false)
+    };
+
+    Ok(RawExecToolCallOutput {
+        exit_status: synthetic_exit_status_for_code(code),
+        stdout: StreamOutput {
+            text: data.clone(),
+            truncated_after_lines: None,
+        },
+        stderr: StreamOutput {
+            text: Vec::new(),
+            truncated_after_lines: None,
+        },
+        aggregated_output: StreamOutput {
+            text: data,
+            truncated_after_lines: None,
+        },
+        timed_out,
+    })
+}
+
+#[cfg(target_os = "ios")]
+pub(crate) fn ios_exec_hook_timed_out(code: i32) -> bool {
+    code == EXEC_TIMEOUT_EXIT_CODE || code == IOS_EXEC_HOOK_TIMEOUT_CODE
+}
