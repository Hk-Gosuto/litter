+#[test]
+fn dynamic_tool_spec_matches_top_level_function() {
+    let specs = vec![codex_protocol::dynamic_tools::DynamicToolSpec::Function(
+        function_spec("list_servers"),
+    )];
+    assert!(dynamic_tool_spec_matches(&specs, "list_servers", None));
+    assert!(!dynamic_tool_spec_matches(
+        &specs,
+        "list_servers",
+        Some("widgets")
+    ));
+    assert!(!dynamic_tool_spec_matches(&specs, "show_widget", None));
+}
+
+#[test]
+fn dynamic_tool_spec_matches_namespaced_function() {
+    let specs = vec![codex_protocol::dynamic_tools::DynamicToolSpec::Namespace(
+        codex_protocol::dynamic_tools::DynamicToolNamespaceSpec {
+            name: "widgets".to_string(),
+            description: "widgets".to_string(),
+            tools: vec![
+                codex_protocol::dynamic_tools::DynamicToolNamespaceTool::Function(function_spec(
+                    "show_widget",
+                )),
+            ],
+        },
+    )];
+    assert!(dynamic_tool_spec_matches(
+        &specs,
+        "show_widget",
+        Some("widgets")
+    ));
+    assert!(dynamic_tool_spec_matches(&specs, "show_widget", None));
+    assert!(!dynamic_tool_spec_matches(
+        &specs,
+        "show_widget",
+        Some("other")
+    ));
+}
