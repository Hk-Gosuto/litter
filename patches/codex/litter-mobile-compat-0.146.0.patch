+struct MockIosLiveProcess {
+    reads: Mutex<VecDeque<crate::exec::IosLiveRead>>,
+    write_status: crate::exec::IosLiveWriteStatus,
+    terminated: std::sync::atomic::AtomicBool,
+}
+
+impl crate::exec::IosLiveExecProcess for MockIosLiveProcess {
+    fn read(
+        &self,
+        _after_seq: Option<u64>,
+        _max_bytes: Option<usize>,
+        _wait_ms: Option<u64>,
+    ) -> Pin<Box<dyn Future<Output = std::result::Result<crate::exec::IosLiveRead, String>> + Send + '_>>
+    {
+        Box::pin(async {
+            if self.terminated.load(std::sync::atomic::Ordering::SeqCst) {
+                return Ok(crate::exec::IosLiveRead {
+                    chunks: Vec::new(),
+                    next_seq: 1,
+                    exited: true,
+                    exit_code: Some(0),
+                    closed: true,
+                    failure: None,
+                });
+            }
+            Ok(self.reads.lock().await.pop_front().unwrap_or_default())
+        })
+    }
+
+    fn write(
+        &self,
+        _data: Vec<u8>,
+    ) -> Pin<
+        Box<dyn Future<Output = std::result::Result<crate::exec::IosLiveWriteStatus, String>> + Send + '_>,
+    > {
+        Box::pin(async { Ok(self.write_status) })
+    }
+
+    fn signal(
+        &self,
+        _signum: i32,
+    ) -> Pin<Box<dyn Future<Output = std::result::Result<(), String>> + Send + '_>> {
+        Box::pin(async { Ok(()) })
+    }
+
+    fn terminate(&self) -> Pin<Box<dyn Future<Output = std::result::Result<(), String>> + Send + '_>> {
+        Box::pin(async {
+            self.terminated
+                .store(true, std::sync::atomic::Ordering::SeqCst);
+            Ok(())
+        })
+    }
+}
