+#[tokio::test]
+async fn ios_live_process_stays_alive_past_initial_grace() {
+    let live = Arc::new(MockIosLiveProcess {
+        reads: Mutex::new(VecDeque::new()),
+        write_status: crate::exec::IosLiveWriteStatus::Accepted,
+        terminated: std::sync::atomic::AtomicBool::new(false),
+    });
+    let process = UnifiedExecProcess::from_ios_live(live)
+        .await
+        .expect("live process should start");
+
+    tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+    assert!(
+        !process.has_exited(),
+        "long-running iOS live process must keep process_id after the initial yield grace"
+    );
+
+    process
+        .terminate_confirmed()
+        .await
+        .expect("terminate should succeed");
+    assert!(process.has_exited());
+}
