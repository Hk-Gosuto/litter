+                    last_seq = *seq;
+                    let mut guard = output_buffer.lock().await;
+                    guard.push_chunk(bytes.clone());
+                    drop(guard);
+                    let _ = output_tx.send(bytes.clone());
+                    output_notify.notify_waiters();
+                }
+                last_seq = last_seq.max(next_seq.saturating_sub(1));
+                if let Some(message) = failure {
+                    let state = state_tx.borrow().clone();
+                    let _ = state_tx.send_replace(state.failed(message));
+                    output_closed.store(true, Ordering::Release);
+                    output_closed_notify.notify_waiters();
+                    cancellation_token.cancel();
+                    break;
+                }
+                if exited {
+                    let state = state_tx.borrow().clone();
+                    let _ = state_tx.send_replace(state.exited(exit_code));
+                }
+                // iSH may still emit output after Exited; only Closed is EOF.
+                // If Closed never arrives after exit (failed session), stop
+                // after two empty post-exit polls (~500ms).
+                if exited && chunks.is_empty() {
+                    empty_reads_after_exit = empty_reads_after_exit.saturating_add(1);
+                } else {
+                    empty_reads_after_exit = 0;
+                }
+                if closed || empty_reads_after_exit >= 2 {
+                    output_closed.store(true, Ordering::Release);
+                    output_closed_notify.notify_waiters();
+                    cancellation_token.cancel();
+                    break;
+                }
+            }
+        })
+    }
