+/// Per-invocation cancellation for iOS exec hooks.
+///
+/// Each `exec()` / apply_patch call gets its own token so cancelling one
+/// command cannot terminate a sibling oneshot.
+#[derive(Clone)]
+pub struct IosExecCancel {
+    inner: Arc<IosExecCancelInner>,
+}
+
+struct IosExecCancelInner {
+    cancelled: AtomicBool,
+    notify: Notify,
+    on_cancel: Mutex<Option<Arc<dyn Fn() + Send + Sync + 'static>>>,
+}
+
+impl IosExecCancel {
+    pub fn new() -> Self {
+        Self {
+            inner: Arc::new(IosExecCancelInner {
+                cancelled: AtomicBool::new(false),
+                notify: Notify::new(),
+                on_cancel: Mutex::new(None),
+            }),
+        }
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.cancelled.load(Ordering::SeqCst)
+    }
+
+    pub fn cancel(&self) {
+        self.inner.cancelled.store(true, Ordering::SeqCst);
+        self.inner.notify.notify_waiters();
+        self.fire_on_cancel();
+    }
+
+    /// Cancels this token when the guard is dropped. Safe to keep alongside
+    /// other clones: only the guard's drop fires cancel.
+    pub fn drop_guard(&self) -> IosExecCancelGuard {
+        IosExecCancelGuard {
+            cancel: self.clone(),
+            armed: true,
+        }
+    }
+
+    /// Register a one-shot callback invoked when this token is cancelled.
+    /// If the token is already cancelled, the callback runs immediately.
+    pub fn set_on_cancel(&self, callback: impl Fn() + Send + Sync + 'static) {
+        if let Ok(mut guard) = self.inner.on_cancel.lock() {
+            *guard = Some(Arc::new(callback));
+        }
+        if self.is_cancelled() {
+            self.fire_on_cancel();
+        }
+    }
+
+    /// Drop the cancel callback without running it. Call this after a
+    /// oneshot finishes so a later `cancel()` / guard drop cannot terminate
+    /// an already-closed session.
+    pub fn clear_on_cancel(&self) {
+        if let Ok(mut guard) = self.inner.on_cancel.lock() {
+            *guard = None;
+        }
+    }
+
+    pub async fn cancelled(&self) {
+        // Subscribe before reading the flag so notify_waiters() cannot
+        // land in the gap between the check and the wait.
+        let notified = self.inner.notify.notified();
+        tokio::pin!(notified);
+        if self.is_cancelled() {
+            return;
+        }
+        notified.await;
+        while !self.is_cancelled() {
+            self.inner.notify.notified().await;
+        }
+    }
+
+    fn fire_on_cancel(&self) {
+        let callback = self
+            .inner
+            .on_cancel
+            .lock()
+            .ok()
+            .and_then(|mut guard| guard.take());
+        if let Some(callback) = callback {
+            callback();
+        }
+    }
+}
+
+pub struct IosExecCancelGuard {
+    cancel: IosExecCancel,
+    armed: bool,
+}
+
+impl IosExecCancelGuard {
+    pub fn disarm(&mut self) {
+        self.armed = false;
+    }
+}
+
+impl Drop for IosExecCancelGuard {
+    fn drop(&mut self) {
+        if self.armed {
+            self.cancel.cancel();
+        }
+    }
+}
+
+#[cfg(target_os = "ios")]
+pub(crate) static IOS_EXEC_HOOK: OnceLock<
+    fn(
+        &[String],
+        &Path,
+        &HashMap<String, String>,
+        Option<u64>,
+        &IosExecCancel,
+    ) -> (i32, Vec<u8>),
+> = OnceLock::new();
+
+#[cfg(target_os = "ios")]
+pub type IosExecOutputHandler = Arc<dyn Fn(Vec<u8>) + Send + Sync + 'static>;
+
+#[cfg(target_os = "ios")]
+pub(crate) static IOS_STREAMING_EXEC_HOOK: OnceLock<
+    fn(
+        &[String],
+        &Path,
+        &HashMap<String, String>,
+        Option<u64>,
+        IosExecOutputHandler,
+        &IosExecCancel,
+    ) -> (i32, Vec<u8>),
+> = OnceLock::new();
+
+#[cfg(target_os = "ios")]
+pub fn set_ios_exec_hook(
+    hook: fn(
+        &[String],
+        &Path,
+        &HashMap<String, String>,
+        Option<u64>,
+        &IosExecCancel,
+    ) -> (i32, Vec<u8>),
+) {
+    let _ = IOS_EXEC_HOOK.set(hook);
