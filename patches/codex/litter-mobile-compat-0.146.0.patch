+#[test]
+fn ios_exec_cancel_is_isolated_per_invocation() {
+    let first = IosExecCancel::new();
+    let second = IosExecCancel::new();
+    let first_hits = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let second_hits = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    {
+        let first_hits = std::sync::Arc::clone(&first_hits);
+        first.set_on_cancel(move || {
+            first_hits.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        });
+    }
+    {
+        let second_hits = std::sync::Arc::clone(&second_hits);
+        second.set_on_cancel(move || {
+            second_hits.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        });
+    }
+
+    first.cancel();
+
+    assert!(first.is_cancelled());
+    assert!(!second.is_cancelled());
+    assert_eq!(first_hits.load(std::sync::atomic::Ordering::SeqCst), 1);
+    assert_eq!(second_hits.load(std::sync::atomic::Ordering::SeqCst), 0);
+
+    let late = IosExecCancel::new();
+    late.cancel();
+    let late_hits = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    {
+        let late_hits = std::sync::Arc::clone(&late_hits);
+        late.set_on_cancel(move || {
+            late_hits.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        });
+    }
+    assert_eq!(late_hits.load(std::sync::atomic::Ordering::SeqCst), 1);
+}
