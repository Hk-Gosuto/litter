+/// True when `path` is absolute on another supported platform even if
+/// `Path::is_absolute` returns false on the current host.
+fn looks_cross_platform_absolute(path: &Path) -> bool {
+    let Some(path) = path.to_str() else {
+        return false;
+    };
+    path.starts_with('/') || path.starts_with(r"\\") || is_windows_drive_absolute_path(path)
+}
