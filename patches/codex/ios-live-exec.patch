+/// Per-invocation cancellation for iOS exec hooks.
+#[cfg(target_os = "ios")]
+#[derive(Clone)]
+pub struct IosExecCancel {
+    inner: Arc<IosExecCancelInner>,
+}
+
+#[cfg(target_os = "ios")]
+struct IosExecCancelInner {
+    cancelled: AtomicBool,
+    notify: Notify,
+    on_cancel: Mutex<Option<Arc<dyn Fn() + Send + Sync + 'static>>>,
+}
+
+#[cfg(target_os = "ios")]
+impl IosExecCancel {
+    pub fn new() -> Self {
+        Self {
+            inner: Arc::new(IosExecCancelInner {
+                cancelled: AtomicBool::new(false),
+                notify: Notify::new(),
+                on_cancel: Mutex::new(None),
+            }),
+        }
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.cancelled.load(Ordering::SeqCst)
+    }
+
+    pub fn cancel(&self) {
+        self.inner.cancelled.store(true, Ordering::SeqCst);
+        self.inner.notify.notify_waiters();
+        self.fire_on_cancel();
+    }
+
+    pub fn drop_guard(&self) -> IosExecCancelGuard {
+        IosExecCancelGuard {
+            cancel: self.clone(),
+            armed: true,
+        }
+    }
+
+    pub fn set_on_cancel(&self, callback: impl Fn() + Send + Sync + 'static) {
+        if let Ok(mut guard) = self.inner.on_cancel.lock() {
+            *guard = Some(Arc::new(callback));
+        }
+        if self.is_cancelled() {
+            self.fire_on_cancel();
+        }
+    }
+
+    pub fn clear_on_cancel(&self) {
+        if let Ok(mut guard) = self.inner.on_cancel.lock() {
+            *guard = None;
+        }
+    }
+
+    pub async fn cancelled(&self) {
+        if self.is_cancelled() {
+            return;
+        }
+        let notified = self.inner.notify.notified();
+        if self.is_cancelled() {
+            return;
+        }
+        notified.await;
+        while !self.is_cancelled() {
+            self.inner.notify.notified().await;
+        }
+    }
+
+    fn fire_on_cancel(&self) {
+        let callback = self
+            .inner
+            .on_cancel
+            .lock()
+            .ok()
+            .and_then(|mut guard| guard.take());
+        if let Some(callback) = callback {
+            callback();
+        }
+    }
+}
+
+#[cfg(target_os = "ios")]
+pub struct IosExecCancelGuard {
+    cancel: IosExecCancel,
+    armed: bool,
+}
+
+#[cfg(target_os = "ios")]
+impl IosExecCancelGuard {
+    pub fn disarm(&mut self) {
+        self.armed = false;
+    }
+}
+
+#[cfg(target_os = "ios")]
+impl Drop for IosExecCancelGuard {
+    fn drop(&mut self) {
+        if self.armed {
+            self.cancel.cancel();
+        }
+    }
+}
